{
  "description": "REACHX MTA-Plugin — SessionStart-Update-Check + Stop-Hook-Token-Sync",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-version.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/post-stop-token-sync.sh"
          }
        ]
      }
    ]
  }
}
