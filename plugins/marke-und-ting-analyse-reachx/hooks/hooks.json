{
  "description": "REACHX MTA-Plugin — Update-Check beim Session-Start",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-version.sh"
          }
        ]
      }
    ]
  }
}
